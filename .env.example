# ==============================================================================
# Configuration Environnement - Application Médicale Traumatologie Tunisie
# ==============================================================================

# Base de données PostgreSQL avec pgvector
# Utiliser 'db' dans Docker Compose, ou 'localhost' pour un lancement local
DATABASE_URL=postgresql+psycopg://traumato:traumato@localhost:5432/traumato

# Clé secrète JWT & Sécurité
SECRET_KEY=traumato-tunisie-secret-key-jwt-2026-traumatologie-secure
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Métadonnées Application
PROJECT_NAME="TraumatoTN - Plateforme Médicale Traumatologie"
API_V1_STR=/api/v1
